# Contact details shown on the website.
# VITE_-prefixed values are compiled into the public client bundle — public info only.

VITE_CONTACT_EMAIL=contact@example.com

# Displayed to visitors, formatted for reading.
VITE_CONTACT_PHONE_DISPLAY=+91 00000 00000

# Used to build wa.me links: country code + number, digits only, no '+' or spaces.
VITE_WHATSAPP_NUMBER=910000000000
